<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="main.master.cs" Inherits="Ecommerce_lego.main" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body style="margin: 0; font-family: Arial;">
    <form id="form1" runat="server">
        <div style="background: #0074D9; padding: 15px; color: white; display: flex; align-items: center; justify-content: space-between;">

            <div style="font-size: 22px; font-weight: bold;">
                LEGO SHOP

            </div>

            <div>
                <asp:TextBox ID="txtSearch" runat="server"
                    placeholder="Search for products..."
                    style="padding:8px; width:250px; border:none; border-radius:20px;">
                    </asp:TextBox>

                    <asp:Button ID="btnSearch" runat="server"
                    Text="🔍"
                    style="padding:8px; background:#ffcc00; border:none; border-radius:20px;" />
                    🔍

            </div>

            <div>
                <asp:Button ID="btnLogout" runat="server" Text="Logout" />
                <a href="#" style="color: white;">Cart</a>
            </div>
        </div>

   

        <!-- Banner -->
        <div style="height: 300px; background: url('images/banner.jpg'); background-size: cover; display: flex; align-items: center; padding-left: 50px; color: white;">
            <div>
                <h1>Welcome to Lego Shop</h1>
                <p>Find your favorite sets</p>

            </div>
        </div>

        <!-- Content -->
        <main>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
            </asp:ContentPlaceHolder>

        </main>
        <!-- Footer -->
        <div style="background: #222; color: white; text-align: center; padding: 15px;">
            © 2026 Lego Shop | All Rights Reserved

        </div>

    </form>
</body>
</html>
